<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}{% if page.url != "/" %} · {{ site.title }}{% endif %}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body{% if spot %} style="--spot-base: {{ spot }}"{% endif %}>
    <aside class="rail">
      <nav class="label" aria-label="Site">
        <ul>
          <li{% if page.url == "/" %} class="here"{% endif %}><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.title }}</a></li>
          <li{% if page.url == "/essays" %} class="here"{% endif %}><a href="/essays"{% if page.url == "/essays" %} aria-current="page"{% endif %}>Essays</a></li>
        </ul>
      </nav>
      {%- if railDate %}
      <p class="label dateline">Published<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      {%- endif %}
      {%- if markInRail %}
      {% include "mark.njk" %}
      {%- endif %}
    </aside>
    {{ content | safe }}
  </body>
</html>
